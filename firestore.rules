rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. GENEL İÇERİK OKUMA İZİNLERİ
    match /posts/{doc} { allow read: if true; }
    match /plays/{doc} { allow read: if true; }
    match /events/{doc} { 
      allow read: if resource.data.visibility == 'PUBLIC'; 
      allow write: if false;
    }
    match /teamNeeds/{doc} { allow read: if true; }
    match /settings/{doc} { allow read: if true; }
    
    // 2. YOKLAMA VE ETKİNLİK SİSTEMİ (Tek Kaynak)
    match /attendance_sessions/{doc} { 
      allow read: if request.auth != null; 
      allow write: if false; // Yalnızca Server Actions (Admin SDK)
    }
    match /attendance_records/{doc} { 
      allow read: if request.auth != null; 
      allow write: if false; // Yalnızca Server Actions (Admin SDK)
    }
    match /attendance_secrets/{doc} { 
      allow read: if false; // Server-only secret (İstemci asla okuyamaz)
      allow write: if false; 
    }
    
    // 3. BİLDİRİMLER VE KULLANICI VERİLERİ (Kişiye Özel İzolasyon)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId; 
      allow write: if false; // Yalnızca Server Actions (Admin SDK)
    }
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Yalnızca Server Actions (Admin SDK)
    }
    match /push_subscriptions/{subId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    match /eventRequests/{reqId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 4. GÜVENLİK BARİYERİ (Tüm kritik yazma işlemleri Firebase Admin SDK / Server Actions üzerinden yapılır)
    match /{document=**} {
      allow write: if false; 
    }
  }
}
